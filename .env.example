# ==========================================
# PORTFOLIO BACKEND EMAIL CONFIGURATION
# ==========================================

# Server Port
PORT=5000

# The email address where you want to receive portfolio contact form submissions
RECIPIENT_EMAIL=anuragreddyadma@gmail.com

# SMTP Server Details (Default: Gmail SMTP)
# For Gmail, generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Your email username (the email account sending the notifications)
SMTP_USER=anuragreddyadma@gmail.com

# Your 16-character Gmail App Password (NOT your regular Gmail password)
# Example: abcd efgh ijkl mnop
SMTP_PASS=your_16_digit_app_password
